{
  "format": "cofailmed_scalar_pack",
  "source_repository": "https://github.com/eunseobchoi/CoFailMed",
  "source_code": "code/ (study implementation that produced the traces)",
  "score_definition": "Per-case Dice as released; float64; no rounding, filtering, aggregation or reordering.",
  "array_schema": {
    "<panel>/dice": "float64 [trace, case]",
    "<panel>/case_ids": "Unicode [case], exact source test_ids shared by every trace in this panel",
    "<panel>/cluster_ids": "Unicode [case], derived resampling labels; not an assertion of patient independence",
    "<panel>/bundle": "Unicode [trace], exact source fm; nnU-Net folds remain separate in fold",
    "<panel>/seed": "int64 [trace], original training seed",
    "<panel>/upstream_family": "Unicode [trace], upstream encoder family; OpenAI CLIP is openai_clip",
    "<panel>/selection_family": "Unicode [trace], family-selection labels; OpenAI CLIP is clip",
    "<panel>/fold": "int64 [trace], only nnU-Net; use fold for same/cross-fold pair groups",
    "<panel>/scored_export_ids": "Unicode [case], only when supplied; original IDs of scored nnU-Net exports",
    "<panel>/case_split_ids": "Unicode [case], only when supplied",
    "<panel>/organ_dice": "float64 [model, case, organ], only AMOS; NaN where the reference organ is empty and Dice is undefined",
    "<panel>/organs": "Unicode [organ], only AMOS; the 13 organs common to all three models",
    "<panel>/model": "Unicode [model], only AMOS; MRSegmentator fold 0, fold 1, then TotalSegmentator",
    "<panel>/system": "Unicode [model], only AMOS; system of each model (the two folds share one)",
    "<panel>/target_empty": "bool [case], only heldout/msd_spleen; reference mask has no foreground",
    "<panel>/prediction_empty": "bool [trace, case], only heldout/msd_spleen; prediction has no foreground",
    "<panel>/err_dice": "pixel_overlap only: [pair, case] Dice between the two heads' error masks (prediction XOR ground truth, 224x224); NaN when both masks are empty",
    "<panel>/fp_dice": "pixel_overlap only: as err_dice for false-positive pixels (error and not ground truth)",
    "<panel>/fn_dice": "pixel_overlap only: as err_dice for false-negative pixels (error and ground truth)",
    "<panel>/pair_a": "pixel_overlap only: int64 [pair], index of the first head in bundle/seed",
    "<panel>/pair_b": "pixel_overlap only: int64 [pair], index of the second head in bundle/seed (pair_a < pair_b)"
  },
  "loading": "numpy.load(path, allow_pickle=False); NPZ keys use panel/field. No object arrays.",
  "panel_construction": {
    "expanded17": "For each primary task, concatenate primary/<task> and cross_checkpoint/<task> rows; case_ids must agree. 68 rows, 17 bundles, seeds 42-45.",
    "family_selection7": "primary/<task> for five primary tasks; heldout/isic2018 and heldout/msd_hippocampus; all 44 traces before calibration-only filtering.",
    "nnunet_riga_alignment": "Original hashed test_ids are retained. scored_export_ids equal primary RIGA case_ids with / replaced by __, in the same order.",
    "amos_case_score": "AMOS dice is the mean of the finite organ_dice values of each case (recorded study values; equal to numpy.nanmean within 1e-12).",
    "kvasir_grouped_expanded17": "Concatenate kvasir_grouped/primary and kvasir_grouped/cross_checkpoint rows, as for expanded17.",
    "mask_align": "mask_align/<task> retrains the primary 1x1 heads with nearest-exact mask resizing; members and case columns equal primary/<task>.",
    "medical": "medical/<task> holds RETFound, RAD-DINO and BiomedParse heads on the primary/<task> cases; Phikon heads are not released.",
    "per_rater": "per_rater/rater_<k>/<task> scores the primary RIGA heads against rater k; the consensus rows of Table C.2 are primary/<task> (identical predictions, 4-of-6 consensus reference).",
    "heldout_msd_empty_masks": "heldout/msd_spleen also stores target_empty [case] and prediction_empty [member, case], the recorded empty-mask flags of its 224x224 central slices; no masks or predictions are included.",
    "pixel_overlap": "pixel_overlap/<task> holds every pair of the floor-retained heads of primary/<task> (kvasir_grouped: kvasir_grouped/primary); values derived from the stored error and ground-truth masks, which are not released. Stored as float32, the precision in which the study computed them."
  },
  "protocol": {
    "functional_floor": 0.3,
    "primary_within_release_pairs": [
      [
        "dinov2_vitb14",
        "dinov2_vits14"
      ]
    ],
    "primary_within_rule": "same bundle across seeds plus all DINOv2-B/S pairs; other pairs are cross-bundle",
    "expanded_pair_rule": "same bundle; distinct bundles with equal upstream_family; different upstream_family",
    "failure_event": "dice < threshold; ties pass",
    "primary_p33": "pooled model-case percentile after per-bundle mean-Dice floor",
    "effective_size": "mean of pool-specific M/[1+(M-1)*mean failure correlation], one head from each of four distinct bundles",
    "support": "at least five failures and five passes for every member; finite correlations and positive denominator",
    "family_selection": "200 splits with seeds 0..199; 50% of sorted resampling units; calibration-only floor; best head per selection_family, top four; candidate-ID tie break",
    "family_selection_threshold": "P33 of the calibration-best functional head; fixed on evaluation half; NOT pooled model-case P33",
    "patient_weighting": "ACDC/BraTS calibration mean Dice averages patient means; failures remain slice-level",
    "unsupported_splits": "remain in total denominator, count as not low M_eff",
    "isic_scope": "image-level analysis; patient overlap exists; not patient-disjoint",
    "hippocampus_scope": "central 2D-slice Dice, one slice per volume; splitting and resampling by volume; subject mapping unavailable; not established patient-disjoint",
    "mask_align_difference": "exact minus nearest gap on one shared set of 2000 seed-0 draws; ACDC patients, other tasks images; recipe-specific 0.30 floors",
    "per_rater_pools": "GT-specific pool: floor applied under each reference; fixed pool: bundles retained under the consensus; 2000 seed-0 image draws shared by all references",
    "medical_delta": "mean r between an encoder's four heads and all retained primary heads, minus the primary cross-bundle mean; 2000 seed-0 image draws",
    "amos_bootstrap": "Pearson: Python random.Random(20260726), 2000 shared volume draws, CT then MRI; P33 effective size and failure metrics: numpy default_rng(0), 2000 volume draws, pooled P33 fixed, support rechecked"
  },
